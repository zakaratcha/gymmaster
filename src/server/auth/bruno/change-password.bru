meta {
  name: change-password
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/current-user/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "changeme",
    "newPassword": "changeme"
  }
}

docs {
  Запускать после login. Ожидается 204 и новая cookie gm_session. Одинаковые пароли выдают новую сессию, не меняя пароль dev-учётки.
}
