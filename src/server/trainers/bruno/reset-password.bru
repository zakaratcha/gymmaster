meta {
  name: reset-password
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/admin/trainers/{{trainerId}}/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "temp-pass-1"
  }
}

docs {
  Сначала login из auth-коллекции (cookie gm_session) под platform_admin. Подставьте trainerId чужой учётки. Ожидается 204 без тела. Пароль в ответе не возвращается.
}
