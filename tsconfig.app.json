{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "lib": ["ES2022", "ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": [
    "src/blocks/**/*",
    "src/services/**/*",
    "src/stores/**/*",
    "src/App.tsx",
    "src/routes/**/*",
    "src/main.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": ["src/server/**", "**/*.stories.tsx"]
}
