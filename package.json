{
  "name": "gymmaster",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "zakaratcha",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx watch src/server/dev.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "playwright:install": "playwright install chromium",
    "typecheck": "npm run typecheck:client && npm run typecheck:storybook && npm run typecheck:server && npm run typecheck:e2e",
    "typecheck:client": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:e2e": "tsc --noEmit -p tests/tsconfig.json",
    "test:e2e": "NODE_OPTIONS='--import tsx/esm' cucumber-js --config tests/_harness/config/cucumber.yml",
    "lint:es": "eslint ./src/ ./tests/ ./.storybook/ vite.config.ts --concurrency=4 --max-warnings=5",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:gherkin": "gherkin-lint",
    "lint:other": "run-s typecheck lint:gherkin lint:styles",
    "lint": "run-p lint:es lint:other",
    "lint-fix:es": "npm run lint:es -- --fix",
    "lint-fix:styles": "npm run lint:styles -- --fix",
    "lint-fix": "run-s typecheck lint-fix:es lint-fix:styles",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@bem-react/classname": "1.8.0",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.9",
    "@radix-ui/react-slot": "1.2.5",
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.10.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "mobx": "6.16.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.2.1",
    "@cucumber/cucumber": "13.0.0",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.4.4",
    "@storybook/addon-docs": "10.4.4",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-vitest": "10.4.4",
    "@storybook/react-vite": "10.4.4",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "0.31.10",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-etc": "2.0.3",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-storybook": "10.4.4",
    "eslint-plugin-total-functions": "7.1.0",
    "eslint-plugin-unicorn": "65.0.1",
    "gherkin-lint": "4.2.4",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "npm-run-all": "4.1.5",
    "playwright": "1.60.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.8.4",
    "storybook": "10.4.4",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-order": "8.1.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "overrides": {
    "eslint": "10.5.0",
    "globals": "17.6.0"
  }
}
